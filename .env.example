# Copia este archivo como .env y completa los valores. NUNCA subas el .env a GitHub.
# URL del nodo Sepolia (Alchemy o Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY
# Clave privada de una wallet SOLO de pruebas (sin fondos reales)
PRIVATE_KEY=0xTU_CLAVE_PRIVADA_DE_PRUEBAS
# Opcional: para verificar el contrato en Etherscan
ETHERSCAN_API_KEY=
